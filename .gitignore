# ==========================
# Data
# (Ignore dataset contents)
# ==========================
data/raw/*
data/processed/*
data/indexes/*
data/outputs/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/indexes/.gitkeep
!data/outputs/.gitkeep

# ==========================
# Models
# (Do NOT upload downloaded models)
# ==========================
models/*

!models/.gitkeep

